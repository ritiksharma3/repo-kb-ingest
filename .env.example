# --- Postgres (default; docker compose up -d, then alembic upgrade head) ---
KB_OWNER_URL=postgresql://kb_owner:kb_owner_dev@localhost:54329/kb
KB_WRITER_URL=postgresql://kb_writer:kb_writer_dev@localhost:54329/kb
KB_READER_URL=postgresql://kb_reader:kb_reader_dev@localhost:54329/kb
KB_WRITER_PASSWORD=kb_writer_dev
KB_READER_PASSWORD=kb_reader_dev

# --- MySQL 8.x alternative: uncomment these (and comment the Postgres URLs above), then `kbingest init-db` ---
# pip install -e ".[mysql]"
# KB_DB=mysql
# KB_OWNER_URL=mysql://root:@127.0.0.1:3306/kb          # XAMPP/WAMP default: root, empty password. Used only by init-db.
# KB_WRITER_URL=mysql://kb_writer:kb_writer_dev@127.0.0.1:3306/kb
# KB_READER_URL=mysql://kb_reader:kb_reader_dev@127.0.0.1:3306/kb
# KB_WRITER_PASSWORD=kb_writer_dev                       # init-db creates the users with these passwords
# KB_READER_PASSWORD=kb_reader_dev
